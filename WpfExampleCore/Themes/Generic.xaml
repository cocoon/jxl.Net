<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WpfExampleCore">

	<Style TargetType="{x:Type local:ImageComparisonSlider}">
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type local:ImageComparisonSlider}">
					<Grid>

						<!-- ZOOMABLE AREA -->
						<local:ZoomBorder x:Name="PART_ZoomBorder" ClipToBounds="True">
							<Canvas x:Name="PART_Canvas">

								<!-- BEFORE IMAGE -->
								<Image Source="{TemplateBinding BeforeImage}"
                                       Stretch="Uniform"
                                       x:Name="PART_BeforeImage" />

								<!-- AFTER IMAGE -->
								<Image Source="{TemplateBinding AfterImage}"
                                       Stretch="Uniform"
                                       x:Name="PART_AfterImage">
									<Image.Clip>
										<RectangleGeometry x:Name="PART_ClipGeometry" />
									</Image.Clip>
								</Image>

							</Canvas>
						</local:ZoomBorder>

						<!-- DIVIDER LINE (NOT ZOOMED) -->
						<Rectangle x:Name="PART_DividerLine"
								   Width="3"
								   Fill="White"
								   HorizontalAlignment="Left"
								   VerticalAlignment="Stretch"
								   IsHitTestVisible="True"
								   Cursor="SizeWE"
								   Panel.ZIndex="10" />

						<!-- SLIDER (NOT ZOOMED) -->
						<Slider x:Name="PART_Slider"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding DividerPosition, RelativeSource={RelativeSource TemplatedParent}}"
                                VerticalAlignment="Bottom"
                                Height="30"
                                Margin="20" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
